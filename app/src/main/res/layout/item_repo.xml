<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_item_user"
    tools:context=".ui.screen_repos.RepoListFragment">

    <TextView
        android:id="@+id/tv_id_repo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="32dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#792EFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.022" />

    <TextView
        android:id="@+id/tv_name_repo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#792EFF"
        app:layout_constraintEnd_toEndOf="@+id/tv_id_repo"
        app:layout_constraintStart_toStartOf="@+id/tv_id_repo"
        app:layout_constraintTop_toBottomOf="@+id/tv_id_repo" />

    <TextView
        android:id="@+id/tv_private_repo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#792EFF"
        app:layout_constraintEnd_toEndOf="@+id/tv_name_repo"
        app:layout_constraintStart_toStartOf="@+id/tv_name_repo"
        app:layout_constraintTop_toBottomOf="@+id/tv_name_repo" />

    <TextView
        android:id="@+id/tv_label_permissions_repo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Permissions:"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#792EFF"
        app:layout_constraintEnd_toEndOf="@+id/tv_private_repo"
        app:layout_constraintStart_toStartOf="@+id/tv_private_repo"
        app:layout_constraintTop_toBottomOf="@+id/tv_private_repo"
        tools:ignore="HardcodedText,TextContrastCheck" />

    <TextView
        android:id="@+id/tv_maintain_repo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#792EFF"
        app:layout_constraintEnd_toEndOf="@+id/tv_label_permissions_repo"
        app:layout_constraintStart_toStartOf="@+id/tv_label_permissions_repo"
        app:layout_constraintTop_toBottomOf="@+id/tv_label_permissions_repo" />

    <TextView
        android:id="@+id/tv_admin_repo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textColor="#792EFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_maintain_repo"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/tv_maintain_repo"
        app:layout_constraintTop_toBottomOf="@+id/tv_maintain_repo" />
</androidx.constraintlayout.widget.ConstraintLayout>